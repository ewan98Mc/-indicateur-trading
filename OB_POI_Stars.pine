//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  SMC ★ TOUT-EN-UN — Order Blocks · POI · Liquidité
//
//  ① Order Blocks notés de 1 à 5 étoiles (3m · 5m · 15m · 4H · Daily · Weekly)
//     1 étoile par confluence : Déplacement · BOS · Sweep liquidité ·
//     Discount/Premium · Tendance (EMA 200)
//  ② POI multi-UT : OB de deux unités de temps qui se superposent (+1 étoile)
//  ③ Liquidité : PDH/PDL, PWH/PWL
//
//  Affichage en traits (par défaut) ou en rectangles — tout s'active / se
//  désactive dans les réglages. Non repaint.
// ═══════════════════════════════════════════════════════════════════════════
indicator("SMC ★ Tout-en-un — OB · POI", shorttitle = "SMC ★", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ═════════════════════════════ RÉGLAGES ═════════════════════════════

// ① Affichage général
grpGen     = "① Affichage général"
drawMode   = input.string("Traits", "Style des zones", options = ["Traits", "Rectangles"], group = grpGen, tooltip = "Traits = une ligne en haut et une ligne en bas de chaque zone (graphique épuré). Rectangles = zones colorées.")
showMid    = input.bool(false, "Ligne du milieu (50 %) en pointillés", group = grpGen)
lineW      = input.int(2, "Épaisseur des traits", minval = 1, maxval = 5, group = grpGen)
fillTransp = input.int(85, "Transparence des rectangles (%)", minval = 0, maxval = 100, group = grpGen)
showLbl    = input.bool(true, "Afficher les étiquettes", group = grpGen)
showDet    = input.bool(false, "Écrire les confluences sur l'étiquette des OB", group = grpGen, tooltip = "Désactivé : les confluences s'affichent quand tu passes la souris sur l'étiquette.")
txtSizeIn  = input.string("Petit", "Taille du texte", options = ["Petit", "Normal", "Grand"], group = grpGen)
lblTransp  = input.int(0, "Transparence des étiquettes (%)", minval = 0, maxval = 100, group = grpGen)
showTable  = input.bool(true, "Afficher le tableau", group = grpGen)
showLegend = input.bool(true, "Afficher la légende sous le tableau", group = grpGen)

// ② Order Blocks
grpOB    = "② Order Blocks"
showOB   = input.bool(true, "Afficher les Order Blocks", group = grpOB)
showBuy  = input.bool(true, "OB acheteurs (▲)", inline = "ob0", group = grpOB)
showSell = input.bool(true, "OB vendeurs (▼)",  inline = "ob0", group = grpOB)
ob3      = input.bool(true, "3m",     inline = "ob1", group = grpOB)
ob5      = input.bool(true, "5m",     inline = "ob1", group = grpOB)
ob15     = input.bool(true, "15m",    inline = "ob1", group = grpOB)
ob4h     = input.bool(true, "4H",     inline = "ob2", group = grpOB)
obD      = input.bool(true, "Daily",  inline = "ob2", group = grpOB)
obW      = input.bool(true, "Weekly", inline = "ob2", group = grpOB)
show5    = input.bool(true,  "5 ★", inline = "ob3", group = grpOB)
show4    = input.bool(true,  "4 ★", inline = "ob3", group = grpOB)
show3    = input.bool(false, "3 ★", inline = "ob3", group = grpOB)
show2    = input.bool(false, "2 ★ (non validé)", inline = "ob4", group = grpOB)
show1    = input.bool(false, "1 ★ (non validé)", inline = "ob4", group = grpOB)
show0    = input.bool(false, "0 ★ (non validé)", inline = "ob5", group = grpOB, tooltip = "Un OB non validé a moins de 3 confluences. Coche ce que tu veux voir, décoche le reste.")
maxPerTF = input.int(2, "OB max par UT et par sens", minval = 1, maxval = 10, group = grpOB)

// ③ POI
grpPoi  = "③ POI (points d'intérêt multi-UT)"
showPoi = input.bool(true, "Afficher les POI", group = grpPoi, tooltip = "Un POI est la zone où un OB d'une unité de temps se superpose à un OB d'une autre unité de temps dans le même sens. Il prend les étoiles du meilleur des deux OB + 1 étoile bonus (max 5).")
poiTF5  = input.bool(true, "5m",     inline = "pt1", group = grpPoi)
poiTF15 = input.bool(true, "15m",    inline = "pt1", group = grpPoi)
poiTF4h = input.bool(true, "4H",     inline = "pt1", group = grpPoi)
poiTFD  = input.bool(true, "Daily",  inline = "pt2", group = grpPoi)
poiTFW  = input.bool(true, "Weekly", inline = "pt2", group = grpPoi, tooltip = "Unité de temps du POI = la plus grande des deux UT qui se superposent (ex : POI 15m+4H = POI 4H).")
poi5    = input.bool(true,  "5 ★", inline = "p1", group = grpPoi)
poi4    = input.bool(true,  "4 ★", inline = "p1", group = grpPoi)
poi3    = input.bool(false, "3 ★", inline = "p1", group = grpPoi)
poi2    = input.bool(false, "2 ★ (non validé)", inline = "p2", group = grpPoi)
poi1    = input.bool(false, "1 ★ (non validé)", inline = "p2", group = grpPoi)
maxPoi  = input.int(3, "POI max par sens", minval = 1, maxval = 20, group = grpPoi)

// ④ Liquidité
grpLiq    = "④ Liquidité"
showPDHL  = input.bool(true, "Plus haut / plus bas de la veille (PDH / PDL)", group = grpLiq)
showPWHL  = input.bool(true, "Plus haut / plus bas de la semaine dernière (PWH / PWL)", group = grpLiq)

// ⑤ OB / POI cassés
grpBrk     = "⑤ OB / POI cassés"
showBroken = input.bool(false, "Afficher les OB / POI cassés (en gris)", group = grpBrk, tooltip = "Un OB acheteur cassé devient souvent une résistance, un OB vendeur cassé un support (breaker block).")
maxBroken  = input.int(5, "Nombre max d'OB / POI cassés affichés", minval = 1, maxval = 50, group = grpBrk)

// ⑥ Détection des OB
grpDet   = "⑥ Détection des OB"
zoneMode = input.string("Mèche", "Zone de l'OB", options = ["Mèche", "Corps"], group = grpDet)
dispMult = input.float(1.5, "Déplacement : corps ≥ x ATR", minval = 0.1, step = 0.1, group = grpDet)
atrLen   = input.int(14, "Longueur ATR", minval = 1, group = grpDet)
swingLen = input.int(5, "Longueur swing (BOS)", minval = 2, group = grpDet)
sweepLen = input.int(20, "Recul prise de liquidité", minval = 3, group = grpDet)
emaLen   = input.int(200, "Longueur EMA tendance", minval = 10, group = grpDet)
invMode  = input.string("Clôture", "OB / POI invalidé par", options = ["Clôture", "Mèche"], group = grpDet)

// ⑦ Couleurs
grpCol      = "⑦ Couleurs"
colBull     = input.color(#089981, "OB acheteur",  inline = "c1", group = grpCol)
colBear     = input.color(#F23645, "OB vendeur",   inline = "c1", group = grpCol)
col5        = input.color(#FFC107, "OB 5 ★",       inline = "c1", group = grpCol)
colPoiBull  = input.color(#2962FF, "POI acheteur", inline = "c2", group = grpCol)
colPoiBear  = input.color(#9C27B0, "POI vendeur",  inline = "c2", group = grpCol)
colLiq      = input.color(#FF9800, "Niveaux de liquidité", inline = "c6", group = grpCol)
colBroken   = input.color(#787B86, "OB / POI cassé", inline = "c7", group = grpCol)
txtCol      = input.color(color.white, "Texte étiquettes", inline = "c9", group = grpCol)
txtCol5     = input.color(color.black, "Texte 5 ★",        inline = "c9", group = grpCol)

alertMinStars = input.int(4, "Alerte si le prix touche un OB / POI d'au moins (étoiles)", minval = 0, maxval = 5, group = "⑧ Alertes")

txtSize = txtSizeIn == "Petit" ? size.small : txtSizeIn == "Grand" ? size.large : size.normal
int futureT = time + 10 * (time - nz(time[1], time))

// ═════════════════════════════ FONCTIONS ═════════════════════════════
starStr(int n) =>
    string s = ""
    for i = 1 to 5
        s := s + (i <= n ? "★" : "☆")
    s

starAllowed(int n) =>
    n == 5 ? show5 : n == 4 ? show4 : n == 3 ? show3 : n == 2 ? show2 : n == 1 ? show1 : show0

poiAllowed(int n) =>
    n == 5 ? poi5 : n == 4 ? poi4 : n == 3 ? poi3 : n == 2 ? poi2 : poi1

// rang des UT : 3m = 1, 5m = 2, 15m = 3, 4H = 4, D = 5, W = 6
poiTFAllowed(int r) =>
    r == 2 ? poiTF5 : r == 3 ? poiTF15 : r == 4 ? poiTF4h : r == 5 ? poiTFD : r == 6 ? poiTFW : false

// masque : DÉPLACEMENT = 1, DISCOUNT/PREMIUM = 2, BOS = 4, SWEEP = 8, TENDANCE = 16
hasBit(int m, int b) =>
    (m % (b * 2)) >= b

countStars(int m) =>
    (hasBit(m, 1) ? 1 : 0) + (hasBit(m, 2) ? 1 : 0) + (hasBit(m, 4) ? 1 : 0) + (hasBit(m, 8) ? 1 : 0) + (hasBit(m, 16) ? 1 : 0)

detTxt(int m, bool bull) =>
    string s = ""
    s := s + (hasBit(m, 1)  ? "✔ Déplacement\n" : "✘ Déplacement\n")
    s := s + (hasBit(m, 4)  ? "✔ BOS\n"         : "✘ BOS\n")
    s := s + (hasBit(m, 8)  ? "✔ Sweep liquidité\n" : "✘ Sweep liquidité\n")
    s := s + (hasBit(m, 2)  ? "✔ " : "✘ ") + (bull ? "Discount\n" : "Premium\n")
    s := s + (hasBit(m, 16) ? "✔ Tendance" : "✘ Tendance")
    s

// Détection des OB, exécutée sur chaque UT via request.security()
// Bougie [2] = OB, bougie [1] = impulsion
obDetect() =>
    float atr         = ta.atr(atrLen)
    float ema         = ta.ema(close, emaLen)
    float ph          = ta.pivothigh(high, swingLen, swingLen)
    float pl          = ta.pivotlow(low, swingLen, swingLen)
    float lowestPrev  = ta.lowest(low, sweepLen)
    float highestPrev = ta.highest(high, sweepLen)

    var float swingHigh = na
    var float swingLow  = na
    if not na(ph)
        swingHigh := ph
    if not na(pl)
        swingLow := pl

    float sh2  = swingHigh[2]
    float sl2  = swingLow[2]
    float lp3  = lowestPrev[3]
    float hp3  = highestPrev[3]
    float atr1 = atr[1]
    float zTop = zoneMode == "Mèche" ? high[2] : math.max(open[2], close[2])
    float zBot = zoneMode == "Mèche" ? low[2]  : math.min(open[2], close[2])
    float zMid = (zTop + zBot) / 2

    // OB acheteur : dernière bougie baissière avant une impulsion haussière
    bool bullBase = close[2] < open[2] and close[1] > open[1] and close[1] > high[2]
    int  bMask    = 0
    bMask += (close[1] - open[1]) >= dispMult * atr1 ? 1 : 0
    bMask += (not na(sh2)) and (not na(sl2)) and zMid < (sh2 + sl2) / 2 ? 2 : 0
    bMask += (not na(sh2)) and math.max(close[1], close) > sh2 ? 4 : 0
    bMask += (not na(lp3)) and low[2] < lp3 ? 8 : 0
    bMask += close > ema ? 16 : 0

    // OB vendeur : dernière bougie haussière avant une impulsion baissière
    bool bearBase = close[2] > open[2] and close[1] < open[1] and close[1] < low[2]
    int  sMask    = 0
    sMask += (open[1] - close[1]) >= dispMult * atr1 ? 1 : 0
    sMask += (not na(sh2)) and (not na(sl2)) and zMid > (sh2 + sl2) / 2 ? 2 : 0
    sMask += (not na(sl2)) and math.min(close[1], close) < sl2 ? 4 : 0
    sMask += (not na(hp3)) and high[2] > hp3 ? 8 : 0
    sMask += close < ema ? 16 : 0

    int t2 = time[2]

    var float bTop = na
    var float bBot = na
    var int   bTm  = 0
    var int   bMk  = 0
    var float sTop = na
    var float sBot = na
    var int   sTm  = 0
    var int   sMk  = 0

    if bullBase
        bTop := zTop
        bBot := zBot
        bTm  := t2
        bMk  := bMask
    if bearBase
        sTop := zTop
        sBot := zBot
        sTm  := t2
        sMk  := sMask

    // [1] = valeurs de la dernière bougie clôturée (non repaint)
    [bTop[1], bBot[1], bTm[1], bMk[1], sTop[1], sBot[1], sTm[1], sMk[1]]

// ═════════════════════════════ DESSIN DES ZONES ═════════════════════════════
type Zone
    box    bx
    line   lt
    line   lbt
    line   lm
    label  lb
    float  top
    float  bot
    int    left
    bool   bull
    int    stars
    string tf
    int    rank
    bool   touched
    bool   shown

zDraw(int left, float top, float bot, color c, int w) =>
    box  bx  = na
    line lt  = na
    line lbt = na
    line lm  = na
    if drawMode == "Rectangles"
        bx := box.new(left, top, time, bot, xloc = xloc.bar_time, border_color = c, border_width = w, bgcolor = color.new(c, fillTransp))
    else
        lt  := line.new(left, top, time, top, xloc = xloc.bar_time, color = c, width = w)
        lbt := line.new(left, bot, time, bot, xloc = xloc.bar_time, color = c, width = w)
    if showMid
        lm := line.new(left, (top + bot) / 2, time, (top + bot) / 2, xloc = xloc.bar_time, color = color.new(c, 30), width = 1, style = line.style_dotted)
    [bx, lt, lbt, lm]

zLabel(string txt, string tip, float y, color c, color tc, string sz) =>
    label lb = na
    if showLbl
        lb := label.new(time, y, txt, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(c, lblTransp), textcolor = tc, size = sz, tooltip = tip, textalign = text.align_left)
    lb

zRight(Zone z, int x) =>
    if not na(z.bx)
        z.bx.set_right(x)
    if not na(z.lt)
        z.lt.set_x2(x)
    if not na(z.lbt)
        z.lbt.set_x2(x)
    if not na(z.lm)
        z.lm.set_x2(x)
    if not na(z.lb)
        z.lb.set_x(x)

zStyle(Zone z, string st) =>
    if not na(z.bx)
        z.bx.set_border_style(st)
    if not na(z.lt)
        z.lt.set_style(st)
    if not na(z.lbt)
        z.lbt.set_style(st)

zColor(Zone z, color c) =>
    if not na(z.bx)
        z.bx.set_border_color(c)
        z.bx.set_bgcolor(color.new(c, fillTransp))
    if not na(z.lt)
        z.lt.set_color(c)
    if not na(z.lbt)
        z.lbt.set_color(c)
    if not na(z.lm)
        z.lm.set_color(color.new(c, 30))
    if not na(z.lb)
        z.lb.set_color(color.new(c, lblTransp))
        z.lb.set_textcolor(color.white)

zDelete(Zone z) =>
    if not na(z.bx)
        z.bx.delete()
    if not na(z.lt)
        z.lt.delete()
    if not na(z.lbt)
        z.lbt.delete()
    if not na(z.lm)
        z.lm.delete()
    if not na(z.lb)
        z.lb.delete()

zFill(Zone z, int left, color c, int w) =>
    [bx, lt, lbt, lm] = zDraw(left, z.top, z.bot, c, w)
    z.bx  := bx
    z.lt  := lt
    z.lbt := lbt
    z.lm  := lm

var array<Zone> obs    = array.new<Zone>()
var array<Zone> pois   = array.new<Zone>()
var array<Zone> broken = array.new<Zone>()

// garde au maximum `maxN` zones d'un même sens (et d'une même UT si tfName n'est pas vide)
prune(array<Zone> arr, bool bull, string tfName, int maxN) =>
    int cnt = 0
    for i = arr.size() - 1 to 0
        Zone o = arr.get(i)
        if o.bull == bull and (tfName == "" or o.tf == tfName)
            cnt += 1
            if cnt > maxN
                zDelete(o)
                arr.remove(i)

// ═════════════════════════════ OB ET POI ═════════════════════════════
addPOI(float top, float bot, int left, int stars, bool bull, string name, string tfBig, int rank) =>
    // pas de doublon : si un POI du même sens chevauche déjà cette zone, on garde le mieux noté
    bool skip = false
    if pois.size() > 0
        for i = pois.size() - 1 to 0
            Zone p = pois.get(i)
            if p.bull == bull and p.top >= bot and p.bot <= top
                if p.stars >= stars
                    skip := true
                else
                    zDelete(p)
                    pois.remove(i)
    if not skip
        color c = bull ? colPoiBull : colPoiBear
        Zone z = Zone.new(top = top, bot = bot, left = left, bull = bull, stars = stars, tf = tfBig, rank = rank, touched = false, shown = true)
        zFill(z, left, c, lineW + 1)
        string tip = "POI " + (bull ? "ACHETEUR" : "VENDEUR") + " " + starStr(stars) + "\nLes OB " + name + " se superposent ici :\nplusieurs unités de temps montrent des ordres importants au même endroit."
        z.lb := zLabel("◆ POI " + tfBig + " " + starStr(stars) + (stars < 3 ? " non validé" : ""), tip, (top + bot) / 2, c, txtCol, txtSize)
        pois.push(z)
        prune(pois, bull, "", maxPoi)

addOB(float top, float bot, int t, int mask, bool bull, string tfName, int rank, bool display) =>
    int  stars = countStars(mask)
    bool shown = display and starAllowed(stars) and (bull ? showBuy : showSell)
    Zone z = Zone.new(top = top, bot = bot, left = t, bull = bull, stars = stars, tf = tfName, rank = rank, touched = false, shown = shown)
    if shown
        color  c   = stars == 5 ? col5 : bull ? colBull : colBear
        string det = detTxt(mask, bull)
        string txt = (bull ? "▲ " : "▼ ") + tfName + " " + starStr(stars) + (stars < 3 ? " non validé" : "") + (showDet ? "\n" + det : "")
        zFill(z, t, c, stars == 5 ? lineW + 1 : lineW)
        z.lb := zLabel(txt, (bull ? "OB ACHETEUR " : "OB VENDEUR ") + tfName + " " + starStr(stars) + "\n" + det, (top + bot) / 2, c, stars == 5 ? txtCol5 : txtCol, txtSize)
    obs.push(z)
    prune(obs, bull, tfName, maxPerTF)
    // POI : cet OB se superpose à un OB d'une autre UT dans le même sens
    if showPoi
        for j = 0 to obs.size() - 1
            Zone o = obs.get(j)
            if o.bull == bull and o.tf != tfName and o.top >= bot and o.bot <= top
                float  pTop   = math.min(o.top, top)
                float  pBot   = math.max(o.bot, bot)
                int    pRank  = math.max(o.rank, rank)
                int    pStars = math.min(5, math.max(o.stars, stars) + 1)
                string pName  = o.rank < rank ? o.tf + "+" + tfName : tfName + "+" + o.tf
                if pTop > pBot and poiAllowed(pStars) and poiTFAllowed(pRank)
                    addPOI(pTop, pBot, math.max(t, o.left), pStars, bull, pName, o.rank > rank ? o.tf : tfName, pRank)
    stars

// Non repaint : dernière bougie CLÔTURÉE de l'UT demandée
handleTF(simple string tf, string tfName, int rank, bool obOn) =>
    [bT, bB, bTm, bM, sT, sB, sTm, sM] = request.security(syminfo.tickerid, tf, obDetect(), lookahead = barmerge.lookahead_on)
    bool usable  = timeframe.in_seconds(tf) >= timeframe.in_seconds()
    bool display = showOB and obOn
    bool detect  = usable and (display or showPoi)
    int  prevB   = nz(bTm[1])
    int  prevS   = nz(sTm[1])
    if detect and bTm > 0 and bTm != prevB and not na(bT)
        addOB(bT, bB, bTm, bM, true, tfName, rank, display)
    if detect and sTm > 0 and sTm != prevS and not na(sT)
        addOB(sT, sB, sTm, sM, false, tfName, rank, display)
    usable and display

bool ok3  = handleTF("3",   "3m",  1, ob3)
bool ok5  = handleTF("5",   "5m",  2, ob5)
bool ok15 = handleTF("15",  "15m", 3, ob15)
bool ok4h = handleTF("240", "4H",  4, ob4h)
bool okD  = handleTF("D",   "D",   5, obD)
bool okW  = handleTF("W",   "W",   6, obW)

// Zones touchées et cassées (OB ou POI)
processZones(array<Zone> arr, string prefix) =>
    bool t5b   = false
    bool t5s   = false
    bool tMin  = false
    bool tBull = false
    bool tBear = false
    if arr.size() > 0
        for i = arr.size() - 1 to 0
            Zone o = arr.get(i)
            bool isBroken = o.bull ? (invMode == "Clôture" ? close < o.bot : low < o.bot) : (invMode == "Clôture" ? close > o.top : high > o.top)
            if isBroken
                arr.remove(i)
                if o.shown and showBroken
                    // la zone reste affichée en gris, arrêtée à la bougie qui l'a cassée
                    zRight(o, time)
                    zColor(o, colBroken)
                    zStyle(o, line.style_dotted)
                    if not na(o.lb)
                        o.lb.delete()
                        o.lb := na
                    broken.push(o)
                    if broken.size() > maxBroken
                        zDelete(broken.shift())
                else
                    zDelete(o)
            else
                bool inZone = o.bull ? low <= o.top : high >= o.bot
                if inZone and not o.touched
                    o.touched := true
                    if o.shown
                        zStyle(o, line.style_dashed)
                        if o.bull
                            tBull := true
                        else
                            tBear := true
                        if o.stars >= alertMinStars
                            tMin := true
                            alert(syminfo.ticker + " : prix sur un " + prefix + (o.bull ? "ACHETEUR " : "VENDEUR ") + starStr(o.stars) + " [" + o.tf + "] " + str.tostring(o.bot, format.mintick) + " - " + str.tostring(o.top, format.mintick), alert.freq_once_per_bar)
                        if o.stars == 5
                            if o.bull
                                t5b := true
                            else
                                t5s := true
                if barstate.islast and o.shown
                    zRight(o, futureT)
    [t5b, t5s, tMin, tBull, tBear]

[ob5Bull, ob5Bear, obMin, obTBull, obTBear]       = processZones(obs, "OB ")
[poi5Bull, poi5Bear, poiMin, poiTBull, poiTBear]  = processZones(pois, "POI ")

// ═════════════════════════════ LIQUIDITÉ ═════════════════════════════
[pdh, pdl, dStart] = request.security(syminfo.tickerid, "D", [high[1], low[1], time], lookahead = barmerge.lookahead_on)
[pwh, pwl, wStart] = request.security(syminfo.tickerid, "W", [high[1], low[1], time], lookahead = barmerge.lookahead_on)

drawLevel(bool show, float price, int x1, string txt) =>
    var line  ln = na
    var label lb = na
    if barstate.islast
        line.delete(ln)
        label.delete(lb)
        if show and not na(price)
            ln := line.new(x1, price, futureT, price, xloc = xloc.bar_time, color = colLiq, style = line.style_dashed, width = 1)
            lb := label.new(futureT, price, txt, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(colLiq, lblTransp), textcolor = txtCol, size = size.small, tooltip = "Niveau de liquidité : beaucoup de stops sont placés ici.")

drawLevel(showPDHL, pdh, dStart, "PDH")
drawLevel(showPDHL, pdl, dStart, "PDL")
drawLevel(showPWHL, pwh, wStart, "PWH")
drawLevel(showPWHL, pwl, wStart, "PWL")

// ═════════════════════════════ ALERTES ═════════════════════════════
alertcondition(ob5Bull or poi5Bull, "OB/POI acheteur 5★ touché", "{{ticker}} : le prix touche un OB ou POI ACHETEUR 5★")
alertcondition(ob5Bear or poi5Bear, "OB/POI vendeur 5★ touché",  "{{ticker}} : le prix touche un OB ou POI VENDEUR 5★")
alertcondition(obMin,  "OB touché (étoiles min)",  "{{ticker}} : le prix touche un OB bien noté")
alertcondition(poiMin, "POI touché (étoiles min)", "{{ticker}} : le prix touche un POI bien noté")

// ═════════════════════════════ TABLEAU ═════════════════════════════
bestStars(string tfName, bool bull) =>
    int best = -1
    if obs.size() > 0
        for i = 0 to obs.size() - 1
            Zone o = obs.get(i)
            if o.shown and o.tf == tfName and o.bull == bull and not o.touched and o.stars > best
                best := o.stars
    best

var table tbl = table.new(position.top_right, 3, 13, bgcolor = color.new(#131722, 0), border_color = color.new(color.gray, 70), border_width = 1, frame_color = color.new(color.gray, 50), frame_width = 1)

fillRow(int row, string tfName, bool usable) =>
    table.cell(tbl, 0, row, tfName, text_color = color.white, text_size = size.small)
    int bu = usable ? bestStars(tfName, true)  : -1
    int be = usable ? bestStars(tfName, false) : -1
    string tu = not usable ? "off" : bu < 0 ? "aucun" : starStr(bu)
    string te = not usable ? "off" : be < 0 ? "aucun" : starStr(be)
    table.cell(tbl, 1, row, tu, text_color = not usable ? color.new(color.gray, 30) : bu == 5 ? col5 : colBull, text_size = size.small)
    table.cell(tbl, 2, row, te, text_color = not usable ? color.new(color.gray, 30) : be == 5 ? col5 : colBear, text_size = size.small)

if showTable and barstate.islast
    table.cell(tbl, 0, 0, "UT",          text_color = color.white, text_size = size.small)
    table.cell(tbl, 1, 0, "OB acheteur", text_color = colBull,     text_size = size.small)
    table.cell(tbl, 2, 0, "OB vendeur",  text_color = colBear,     text_size = size.small)
    fillRow(1, "3m",  ok3)
    fillRow(2, "5m",  ok5)
    fillRow(3, "15m", ok15)
    fillRow(4, "4H",  ok4h)
    fillRow(5, "D",   okD)
    fillRow(6, "W",   okW)
    if showLegend
        table.cell(tbl, 0, 7,  "LÉGENDE", text_color = color.white, text_size = size.small)
        table.merge_cells(tbl, 0, 7, 2, 7)
        table.cell(tbl, 0, 8,  "▲ OB acheteur   ▼ OB vendeur", text_color = color.white, text_size = size.small, text_halign = text.align_left)
        table.merge_cells(tbl, 0, 8, 2, 8)
        table.cell(tbl, 0, 9,  "◆ POI = OB de 2 UT superposés", text_color = colPoiBull, text_size = size.small, text_halign = text.align_left)
        table.merge_cells(tbl, 0, 9, 2, 9)
        table.cell(tbl, 0, 10, "★★★★★ = 5 confluences (doré)", text_color = col5, text_size = size.small, text_halign = text.align_left)
        table.merge_cells(tbl, 0, 10, 2, 10)
        table.cell(tbl, 0, 11, "Trait plein = jamais touché", text_color = color.white, text_size = size.small, text_halign = text.align_left)
        table.merge_cells(tbl, 0, 11, 2, 11)
        table.cell(tbl, 0, 12, "Tirets = déjà touché", text_color = color.white, text_size = size.small, text_halign = text.align_left)
        table.merge_cells(tbl, 0, 12, 2, 12)
