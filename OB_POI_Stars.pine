//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  OB ★ — Order Blocks notés de 1 à 5 étoiles
//  Unités de temps : 3m · 5m · 15m · 4H · Daily · Weekly
//
//  1 étoile par confluence :
//    Déplacement · BOS · Sweep liquidité · Discount/Premium · Tendance (EMA 200)
//
//  + PDH / PDL (veille) et PWH / PWL (semaine dernière)
//  Style au choix : un seul trait, deux traits ou rectangle rempli. Non repaint.
// ═══════════════════════════════════════════════════════════════════════════
indicator("OB ★ — Order Blocks notés", shorttitle = "OB ★", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ═════════════════════════════ RÉGLAGES ═════════════════════════════

// ① Unités de temps
grpTF = "① Unités de temps des OB"
ob3   = input.bool(true, "3m",     inline = "t1", group = grpTF)
ob5   = input.bool(true, "5m",     inline = "t1", group = grpTF)
ob15  = input.bool(true, "15m",    inline = "t1", group = grpTF)
ob4h  = input.bool(true, "4H",     inline = "t2", group = grpTF)
obD   = input.bool(true, "Daily",  inline = "t2", group = grpTF)
obW   = input.bool(true, "Weekly", inline = "t2", group = grpTF, tooltip = "Les unités de temps plus petites que celle de ton graphique ne peuvent pas s'afficher. Pour tout voir, mets ton graphique en 3m (ou 1m).")

// ② OB à afficher
grpSel   = "② OB à afficher"
showBuy  = input.bool(true, "OB acheteurs (▲)", inline = "s0", group = grpSel)
showSell = input.bool(true, "OB vendeurs (▼)",  inline = "s0", group = grpSel)
show5    = input.bool(true,  "5 ★", inline = "s1", group = grpSel)
show4    = input.bool(true,  "4 ★", inline = "s1", group = grpSel)
show3    = input.bool(true,  "3 ★", inline = "s1", group = grpSel)
show2    = input.bool(false, "2 ★", inline = "s2", group = grpSel)
show1    = input.bool(false, "1 ★", inline = "s2", group = grpSel)
show0    = input.bool(false, "0 ★", inline = "s2", group = grpSel, tooltip = "Les OB de 0, 1 ou 2 étoiles sont « non validés » : moins de 3 confluences.")
maxPerTF = input.int(2, "OB max par unité de temps et par sens", minval = 1, maxval = 10, group = grpSel)
useDist  = input.bool(true, "Seulement les OB proches du prix", group = grpSel, tooltip = "Les OB trop loin du prix sont masqués. Ils réapparaissent quand le prix s'en rapproche.")
distAtr  = input.float(3.0, "Distance max (x ATR journalier)", minval = 0.5, step = 0.5, group = grpSel, tooltip = "ATR journalier = mouvement moyen d'une journée. 3 = OB à moins de 3 journées moyennes de mouvement du prix.")

// ③ OB cassés
grpBrk     = "③ OB cassés"
invMode    = input.string("Clôture au travers", "Un OB est cassé quand", options = ["Clôture au travers", "Mèche au travers", "Le prix dépasse 50 % de l'OB"], group = grpBrk, tooltip = "Clôture au travers = une bougie clôture de l'autre côté de l'OB.\nMèche au travers = une mèche traverse tout l'OB.\n50 % = le prix rentre jusqu'au milieu de l'OB sans réagir.")
showBroken = input.bool(false, "Garder les OB cassés à l'écran (en gris)", group = grpBrk, tooltip = "Décoché : un OB cassé disparaît tout seul.\nCoché : il reste en gris pointillé (un OB cassé devient souvent un support / une résistance).")
maxBroken  = input.int(5, "OB cassés max affichés", minval = 1, maxval = 50, group = grpBrk)

// ④ Style
grpSty     = "④ Style"
drawMode   = input.string("Un seul trait", "Style des OB", options = ["Un seul trait", "Deux traits (haut et bas)", "Rectangle rempli"], group = grpSty)
linePos    = input.string("Bord d'entrée", "Position du trait unique", options = ["Bord d'entrée", "Milieu de l'OB (50 %)"], group = grpSty, tooltip = "Bord d'entrée = le haut d'un OB acheteur ou le bas d'un OB vendeur : là où le prix touche l'OB en premier.")
oneColor   = input.bool(false, "Tous les OB d'une seule couleur", inline = "oc", group = grpSty)
colOne     = input.color(color.black, "", inline = "oc", group = grpSty)
lineW      = input.int(2, "Épaisseur des traits", minval = 1, maxval = 5, group = grpSty)
fillTransp = input.int(80, "Transparence des rectangles (%)", minval = 0, maxval = 100, group = grpSty)
lineLen    = input.string("Courts (près du prix)", "Longueur", options = ["Courts (près du prix)", "Depuis la bougie de l'OB"], group = grpSty)
showLbl    = input.bool(true, "Afficher les étiquettes (UT + étoiles)", group = grpSty)
txtSizeIn  = input.string("Petit", "Taille du texte", options = ["Petit", "Normal", "Grand"], group = grpSty)
showTable  = input.bool(true, "Afficher le tableau", group = grpSty)

// ⑤ Liquidité
grpLiq   = "⑤ Liquidité"
showPDHL = input.bool(true, "PDH / PDL (plus haut / plus bas de la veille)", group = grpLiq)
showPWHL = input.bool(true, "PWH / PWL (plus haut / plus bas de la semaine dernière)", group = grpLiq)

// ⑥ Couleurs
grpCol    = "⑥ Couleurs"
colBull   = input.color(#089981, "OB acheteur", inline = "c1", group = grpCol)
colBear   = input.color(#F23645, "OB vendeur",  inline = "c1", group = grpCol)
col5      = input.color(#FFC107, "OB 5 ★",      inline = "c1", group = grpCol)
colLiq    = input.color(#FF9800, "PDH / PDL / PWH / PWL", inline = "c2", group = grpCol)
colBroken = input.color(#9598A1, "OB cassé",              inline = "c2", group = grpCol)
txtCol    = input.color(color.white, "Texte", inline = "c3", group = grpCol)
txtCol5   = input.color(color.black, "Texte 5 ★", inline = "c3", group = grpCol)

// ⑦ Détection (avancé)
grpDet   = "⑦ Détection (avancé)"
zoneMode = input.string("Mèche", "Zone de l'OB", options = ["Mèche", "Corps"], group = grpDet)
dispMult = input.float(1.5, "Déplacement : corps ≥ x ATR", minval = 0.1, step = 0.1, group = grpDet)
atrLen   = input.int(14, "Longueur ATR", minval = 1, group = grpDet)
swingLen = input.int(5, "Longueur swing (BOS)", minval = 2, group = grpDet)
sweepLen = input.int(20, "Recul prise de liquidité", minval = 3, group = grpDet)
emaLen   = input.int(200, "Longueur EMA tendance", minval = 10, group = grpDet)

alertMinStars = input.int(4, "Alerte quand le prix touche un OB d'au moins (étoiles)", minval = 0, maxval = 5, group = "⑧ Alertes")

txtSize = txtSizeIn == "Petit" ? size.small : txtSizeIn == "Grand" ? size.large : size.normal
int   barMs   = time - nz(time[1], time)
int   futureT = time + 4 * barMs     // étiquettes des OB
int   futureL = time + 16 * barMs    // étiquettes PDH / PDL / PWH / PWL
int   shortL  = time - 15 * barMs    // début des traits courts
float dAtr    = request.security(syminfo.tickerid, "D", ta.atr(14)[1], lookahead = barmerge.lookahead_on)

// ═════════════════════════════ FONCTIONS ═════════════════════════════
starStr(int n) =>
    string s = ""
    for i = 1 to 5
        s := s + (i <= n ? "★" : "☆")
    s

starAllowed(int n) =>
    n == 5 ? show5 : n == 4 ? show4 : n == 3 ? show3 : n == 2 ? show2 : n == 1 ? show1 : show0

// masque : DÉPLACEMENT = 1, DISCOUNT/PREMIUM = 2, BOS = 4, SWEEP = 8, TENDANCE = 16
hasBit(int m, int b) =>
    (m % (b * 2)) >= b

countStars(int m) =>
    (hasBit(m, 1) ? 1 : 0) + (hasBit(m, 2) ? 1 : 0) + (hasBit(m, 4) ? 1 : 0) + (hasBit(m, 8) ? 1 : 0) + (hasBit(m, 16) ? 1 : 0)

detTxt(int m, bool bull) =>
    string s = ""
    s := s + (hasBit(m, 1)  ? "✔ Déplacement\n" : "✘ Déplacement\n")
    s := s + (hasBit(m, 4)  ? "✔ BOS\n"         : "✘ BOS\n")
    s := s + (hasBit(m, 8)  ? "✔ Sweep liquidité\n" : "✘ Sweep liquidité\n")
    s := s + (hasBit(m, 2)  ? "✔ " : "✘ ") + (bull ? "Discount\n" : "Premium\n")
    s := s + (hasBit(m, 16) ? "✔ Tendance" : "✘ Tendance")
    s

// Détection des OB, exécutée sur chaque UT via request.security()
// Bougie [2] = OB, bougie [1] = impulsion
obDetect() =>
    float atr         = ta.atr(atrLen)
    float ema         = ta.ema(close, emaLen)
    float ph          = ta.pivothigh(high, swingLen, swingLen)
    float pl          = ta.pivotlow(low, swingLen, swingLen)
    float lowestPrev  = ta.lowest(low, sweepLen)
    float highestPrev = ta.highest(high, sweepLen)

    var float swingHigh = na
    var float swingLow  = na
    if not na(ph)
        swingHigh := ph
    if not na(pl)
        swingLow := pl

    float sh2  = swingHigh[2]
    float sl2  = swingLow[2]
    float lp3  = lowestPrev[3]
    float hp3  = highestPrev[3]
    float atr1 = atr[1]
    float zTop = zoneMode == "Mèche" ? high[2] : math.max(open[2], close[2])
    float zBot = zoneMode == "Mèche" ? low[2]  : math.min(open[2], close[2])
    float zMid = (zTop + zBot) / 2

    // OB acheteur : dernière bougie baissière avant une impulsion haussière
    bool bullBase = close[2] < open[2] and close[1] > open[1] and close[1] > high[2]
    int  bMask    = 0
    bMask += (close[1] - open[1]) >= dispMult * atr1 ? 1 : 0
    bMask += (not na(sh2)) and (not na(sl2)) and zMid < (sh2 + sl2) / 2 ? 2 : 0
    bMask += (not na(sh2)) and math.max(close[1], close) > sh2 ? 4 : 0
    bMask += (not na(lp3)) and low[2] < lp3 ? 8 : 0
    bMask += close > ema ? 16 : 0

    // OB vendeur : dernière bougie haussière avant une impulsion baissière
    bool bearBase = close[2] > open[2] and close[1] < open[1] and close[1] < low[2]
    int  sMask    = 0
    sMask += (open[1] - close[1]) >= dispMult * atr1 ? 1 : 0
    sMask += (not na(sh2)) and (not na(sl2)) and zMid > (sh2 + sl2) / 2 ? 2 : 0
    sMask += (not na(sl2)) and math.min(close[1], close) < sl2 ? 4 : 0
    sMask += (not na(hp3)) and high[2] > hp3 ? 8 : 0
    sMask += close < ema ? 16 : 0

    int t2 = time[2]

    var float bTop = na
    var float bBot = na
    var int   bTm  = 0
    var int   bMk  = 0
    var float sTop = na
    var float sBot = na
    var int   sTm  = 0
    var int   sMk  = 0

    if bullBase
        bTop := zTop
        bBot := zBot
        bTm  := t2
        bMk  := bMask
    if bearBase
        sTop := zTop
        sBot := zBot
        sTm  := t2
        sMk  := sMask

    // [1] = valeurs de la dernière bougie clôturée (non repaint)
    [bTop[1], bBot[1], bTm[1], bMk[1], sTop[1], sBot[1], sTm[1], sMk[1]]

// ═════════════════════════════ DESSIN ═════════════════════════════
type Zone
    box    bx
    line   l1
    line   l2
    label  lb
    float  top
    float  bot
    int    left
    bool   bull
    int    stars
    string tf
    bool   touched
    color  col
    color  tcol

// niveau du trait unique
lineY(bool bull, float top, float bot) =>
    linePos == "Bord d'entrée" ? (bull ? top : bot) : (top + bot) / 2

zRight(Zone z, int x) =>
    if not na(z.bx)
        z.bx.set_right(x)
    if not na(z.l1)
        z.l1.set_x2(x)
    if not na(z.l2)
        z.l2.set_x2(x)
    if not na(z.lb)
        z.lb.set_x(x)

zLeft(Zone z, int x) =>
    if not na(z.bx)
        z.bx.set_left(x)
    if not na(z.l1)
        z.l1.set_x1(x)
    if not na(z.l2)
        z.l2.set_x1(x)

zStyle(Zone z, string st) =>
    if not na(z.bx)
        z.bx.set_border_style(st)
    if not na(z.l1)
        z.l1.set_style(st)
    if not na(z.l2)
        z.l2.set_style(st)

// visible / invisible sans supprimer (filtre de distance)
zShow(Zone z, bool v) =>
    color c = v ? z.col : color.new(z.col, 100)
    if not na(z.bx)
        z.bx.set_border_color(c)
        z.bx.set_bgcolor(color.new(z.col, v ? fillTransp : 100))
    if not na(z.l1)
        z.l1.set_color(c)
    if not na(z.l2)
        z.l2.set_color(c)
    if not na(z.lb)
        z.lb.set_color(c)
        z.lb.set_textcolor(v ? z.tcol : color.new(z.tcol, 100))

zDelete(Zone z) =>
    if not na(z.bx)
        z.bx.delete()
    if not na(z.l1)
        z.l1.delete()
    if not na(z.l2)
        z.l2.delete()
    if not na(z.lb)
        z.lb.delete()

var array<Zone> obs    = array.new<Zone>()
var array<Zone> broken = array.new<Zone>()

addOB(float top, float bot, int t, int mask, bool bull, string tfName) =>
    int    stars = countStars(mask)
    color  c     = oneColor ? colOne : stars == 5 ? col5 : bull ? colBull : colBear
    color  tc    = (not oneColor and stars == 5) ? txtCol5 : txtCol
    box    bx    = na
    line   l1    = na
    line   l2    = na
    float  ly    = (top + bot) / 2
    if drawMode == "Rectangle rempli"
        bx := box.new(t, top, time, bot, xloc = xloc.bar_time, border_color = c, border_width = 1, bgcolor = color.new(c, fillTransp))
    else if drawMode == "Deux traits (haut et bas)"
        l1 := line.new(t, top, time, top, xloc = xloc.bar_time, color = c, width = lineW)
        l2 := line.new(t, bot, time, bot, xloc = xloc.bar_time, color = c, width = lineW)
    else
        ly := lineY(bull, top, bot)
        l1 := line.new(t, ly, time, ly, xloc = xloc.bar_time, color = c, width = lineW)
    label lb = na
    if showLbl
        string txt = (bull ? "▲ " : "▼ ") + tfName + " " + starStr(stars) + (stars < 3 ? " non validé" : "")
        string tip = (bull ? "OB ACHETEUR " : "OB VENDEUR ") + tfName + " " + starStr(stars) + "\nZone : " + str.tostring(bot, format.mintick) + " – " + str.tostring(top, format.mintick) + "\n" + detTxt(mask, bull)
        lb := label.new(time, ly, txt, xloc = xloc.bar_time, style = label.style_label_left, color = c, textcolor = tc, size = txtSize, tooltip = tip)
    obs.push(Zone.new(bx, l1, l2, lb, top, bot, t, bull, stars, tfName, false, c, tc))
    // garder seulement les maxPerTF OB les plus récents pour cette UT et ce sens
    int cnt = 0
    for i = obs.size() - 1 to 0
        Zone o = obs.get(i)
        if o.bull == bull and o.tf == tfName
            cnt += 1
            if cnt > maxPerTF
                zDelete(o)
                obs.remove(i)
    stars

// Non repaint : dernière bougie CLÔTURÉE de l'UT demandée
handleTF(simple string tf, string tfName, bool on) =>
    [bT, bB, bTm, bM, sT, sB, sTm, sM] = request.security(syminfo.tickerid, tf, obDetect(), lookahead = barmerge.lookahead_on)
    bool usable = on and timeframe.in_seconds(tf) >= timeframe.in_seconds()
    int  prevB  = nz(bTm[1])
    int  prevS  = nz(sTm[1])
    if usable and showBuy and bTm > 0 and bTm != prevB and not na(bT) and starAllowed(countStars(bM))
        addOB(bT, bB, bTm, bM, true, tfName)
    if usable and showSell and sTm > 0 and sTm != prevS and not na(sT) and starAllowed(countStars(sM))
        addOB(sT, sB, sTm, sM, false, tfName)
    usable

bool ok3  = handleTF("3",   "3m",  ob3)
bool ok5  = handleTF("5",   "5m",  ob5)
bool ok15 = handleTF("15",  "15m", ob15)
bool ok4h = handleTF("240", "4H",  ob4h)
bool okD  = handleTF("D",   "D",   obD)
bool okW  = handleTF("W",   "W",   obW)

// ═════════════════════════════ OB TOUCHÉS / CASSÉS ═════════════════════════════
bool touch5Bull = false
bool touch5Bear = false
bool touchMin   = false

if obs.size() > 0
    for i = obs.size() - 1 to 0
        Zone o = obs.get(i)
        float mid      = (o.top + o.bot) / 2
        bool  isBroken = invMode == "Clôture au travers" ? (o.bull ? close < o.bot : close > o.top) : invMode == "Mèche au travers" ? (o.bull ? low < o.bot : high > o.top) : (o.bull ? low < mid : high > mid)
        if isBroken
            obs.remove(i)
            if showBroken
                // l'OB reste en gris pointillé, arrêté à la bougie qui l'a cassé, sans étiquette
                o.col := colBroken
                zShow(o, true)
                zStyle(o, line.style_dotted)
                zRight(o, time)
                if not na(o.lb)
                    o.lb.delete()
                    o.lb := na
                broken.push(o)
                if broken.size() > maxBroken
                    zDelete(broken.shift())
            else
                zDelete(o)
        else
            bool inZone = o.bull ? low <= o.top : high >= o.bot
            if inZone and not o.touched
                o.touched := true
                zStyle(o, line.style_dashed)
                if o.stars >= alertMinStars
                    touchMin := true
                    alert(syminfo.ticker + " : prix sur un OB " + (o.bull ? "ACHETEUR " : "VENDEUR ") + starStr(o.stars) + " [" + o.tf + "] " + str.tostring(o.bot, format.mintick) + " - " + str.tostring(o.top, format.mintick), alert.freq_once_per_bar)
                if o.stars == 5
                    if o.bull
                        touch5Bull := true
                    else
                        touch5Bear := true
            if barstate.islast
                zRight(o, futureT)
                if lineLen == "Courts (près du prix)"
                    zLeft(o, math.max(o.left, shortL))
                float dist = close > o.top ? close - o.top : close < o.bot ? o.bot - close : 0.0
                zShow(o, not useDist or na(dAtr) or dist <= distAtr * dAtr)

// ═════════════════════════════ PDH / PDL / PWH / PWL ═════════════════════════════
[pdh, pdl, dStart] = request.security(syminfo.tickerid, "D", [high[1], low[1], time], lookahead = barmerge.lookahead_on)
[pwh, pwl, wStart] = request.security(syminfo.tickerid, "W", [high[1], low[1], time], lookahead = barmerge.lookahead_on)

drawLevel(bool show, float price, int x1, string txt) =>
    var line  ln = na
    var label lb = na
    if barstate.islast
        line.delete(ln)
        label.delete(lb)
        if show and not na(price)
            ln := line.new(x1, price, futureL, price, xloc = xloc.bar_time, color = colLiq, style = line.style_dashed, width = 1)
            lb := label.new(futureL, price, txt, xloc = xloc.bar_time, style = label.style_label_left, color = colLiq, textcolor = txtCol, size = size.small, tooltip = txt + " : " + str.tostring(price, format.mintick) + "\nNiveau de liquidité (beaucoup de stops sont placés ici).")

drawLevel(showPDHL, pdh, dStart, "PDH")
drawLevel(showPDHL, pdl, dStart, "PDL")
drawLevel(showPWHL, pwh, wStart, "PWH")
drawLevel(showPWHL, pwl, wStart, "PWL")

// ═════════════════════════════ ALERTES ═════════════════════════════
alertcondition(touch5Bull, "OB acheteur 5★ touché", "{{ticker}} : le prix touche un OB ACHETEUR 5★")
alertcondition(touch5Bear, "OB vendeur 5★ touché",  "{{ticker}} : le prix touche un OB VENDEUR 5★")
alertcondition(touchMin,   "OB touché (étoiles min)", "{{ticker}} : le prix touche un OB bien noté")

// ═════════════════════════════ TABLEAU ═════════════════════════════
bestStars(string tfName, bool bull) =>
    int best = -1
    if obs.size() > 0
        for i = 0 to obs.size() - 1
            Zone o = obs.get(i)
            if o.tf == tfName and o.bull == bull and not o.touched and o.stars > best
                best := o.stars
    best

var table tbl = table.new(position.top_right, 3, 7, bgcolor = color.new(#131722, 0), border_color = color.new(color.gray, 70), border_width = 1, frame_color = color.new(color.gray, 50), frame_width = 1)

fillRow(int row, string tfName, bool usable) =>
    table.cell(tbl, 0, row, tfName, text_color = color.white, text_size = size.small)
    int bu = usable ? bestStars(tfName, true)  : -1
    int be = usable ? bestStars(tfName, false) : -1
    string tu = not usable ? "off" : bu < 0 ? "—" : starStr(bu)
    string te = not usable ? "off" : be < 0 ? "—" : starStr(be)
    table.cell(tbl, 1, row, tu, text_color = not usable ? color.gray : bu == 5 ? col5 : colBull, text_size = size.small)
    table.cell(tbl, 2, row, te, text_color = not usable ? color.gray : be == 5 ? col5 : colBear, text_size = size.small)

if showTable and barstate.islast
    table.cell(tbl, 0, 0, "UT",          text_color = color.white, text_size = size.small)
    table.cell(tbl, 1, 0, "OB acheteur", text_color = colBull,     text_size = size.small)
    table.cell(tbl, 2, 0, "OB vendeur",  text_color = colBear,     text_size = size.small)
    fillRow(1, "3m",  ok3)
    fillRow(2, "5m",  ok5)
    fillRow(3, "15m", ok15)
    fillRow(4, "4H",  ok4h)
    fillRow(5, "D",   okD)
    fillRow(6, "W",   okW)
