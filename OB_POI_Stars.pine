//@version=6
// ═══════════════════════════════════════════════════════════════════
//  OB POI ★ — Order Blocks multi-unités de temps notés de 1 à 5 étoiles
//  1 étoile par confluence :
//    DÉPLACEMENT = impulsion forte après l'OB (corps ≥ X × ATR)
//    BOS         = l'impulsion casse le dernier sommet / creux
//    SWEEP       = la bougie OB prend la liquidité (plus bas / plus haut récent)
//    DISCOUNT / PREMIUM = OB haussier sous le 50 % du range, OB baissier au-dessus
//    TENDANCE    = OB dans le sens de la tendance (EMA 200)
//  UT : 3m · 5m · 15m · 4H · Daily · Weekly — Non repaint
// ═══════════════════════════════════════════════════════════════════
indicator("OB POI ★ — Order Blocks Multi-UT", shorttitle = "OB POI ★", overlay = true, max_boxes_count = 500, max_labels_count = 500)

// ───────────── Réglages ─────────────
grpTF = "Unités de temps"
use3  = input.bool(true, "3 min",  inline = "t1", group = grpTF)
use5  = input.bool(true, "5 min",  inline = "t1", group = grpTF)
use15 = input.bool(true, "15 min", inline = "t1", group = grpTF)
use4h = input.bool(true, "4 H",    inline = "t2", group = grpTF)
useD  = input.bool(true, "Daily",  inline = "t2", group = grpTF)
useW  = input.bool(true, "Weekly", inline = "t2", group = grpTF)

grpDet   = "Détection"
zoneMode = input.string("Mèche", "Zone de l'OB", options = ["Mèche", "Corps"], group = grpDet)
dispMult = input.float(1.5, "Déplacement : corps ≥ x ATR", minval = 0.1, step = 0.1, group = grpDet)
atrLen   = input.int(14, "Longueur ATR", minval = 1, group = grpDet)
swingLen = input.int(5, "Longueur swing (BOS)", minval = 2, group = grpDet)
sweepLen = input.int(20, "Recul prise de liquidité", minval = 3, group = grpDet)
emaLen   = input.int(200, "Longueur EMA tendance", minval = 10, group = grpDet)
invMode  = input.string("Clôture", "OB invalidé par", options = ["Clôture", "Mèche"], group = grpDet)

grpBrk     = "OB cassés (invalidés)"
showBroken = input.bool(true, "Afficher les OB cassés (coché = activé, décoché = désactivé)", group = grpBrk, tooltip = "Un OB cassé reste affiché en gris, arrêté à la bougie qui l'a cassé. Un OB acheteur cassé devient souvent une résistance, un OB vendeur cassé un support (breaker block).")
maxBroken  = input.int(10, "Nombre max d'OB cassés affichés", minval = 1, maxval = 50, group = grpBrk)
colBroken  = input.color(#787B86, "Couleur des OB cassés", group = grpBrk)

grpDisp   = "Affichage"
minStars  = input.int(3, "Afficher les OB d'au moins (étoiles)", minval = 0, maxval = 5, group = grpDisp)
maxPerTF  = input.int(3, "OB actifs max par UT et par sens", minval = 1, maxval = 10, group = grpDisp)
showLbl   = input.bool(true, "Afficher l'étiquette (UT + étoiles)", group = grpDisp)
showDet   = input.bool(false, "Écrire aussi les confluences sur l'étiquette", group = grpDisp, tooltip = "Désactivé : les confluences s'affichent quand tu passes la souris sur l'étiquette.")
showTable = input.bool(true, "Afficher le tableau", group = grpDisp)

grpCol    = "Couleurs"
colBull   = input.color(#089981, "OB haussier",  inline = "c1", group = grpCol)
colBear   = input.color(#F23645, "OB baissier",  inline = "c1", group = grpCol)
col5      = input.color(#FFC107, "OB 5 ★",       inline = "c1", group = grpCol)
fillTransp = input.int(85, "Transparence du fond de la zone (%)", minval = 0, maxval = 100, group = grpCol)
borderW   = input.int(1, "Épaisseur de la bordure", minval = 0, maxval = 4, group = grpCol)
txtCol    = input.color(color.white, "Texte étiquette", inline = "c2", group = grpCol)
txtCol5   = input.color(color.black, "Texte étiquette 5 ★", inline = "c2", group = grpCol)
lblTransp = input.int(0, "Transparence de l'étiquette (%)", minval = 0, maxval = 100, group = grpCol)
txtSizeIn = input.string("Normal", "Taille du texte", options = ["Petit", "Normal", "Grand"], group = grpCol)
txtSize   = txtSizeIn == "Petit" ? size.small : txtSizeIn == "Grand" ? size.large : size.normal

alertMinStars = input.int(4, "Alerte si le prix touche un OB d'au moins (étoiles)", minval = 0, maxval = 5, group = "Alertes")

// ───────────── Fonctions utiles ─────────────
starStr(int n) =>
    string s = ""
    for i = 1 to 5
        s := s + (i <= n ? "★" : "☆")
    s

// masque : DÉPLACEMENT = 1, DISCOUNT/PREMIUM = 2, BOS = 4, SWEEP = 8, TENDANCE = 16
hasBit(int m, int b) =>
    (m % (b * 2)) >= b

countStars(int m) =>
    (hasBit(m, 1) ? 1 : 0) + (hasBit(m, 2) ? 1 : 0) + (hasBit(m, 4) ? 1 : 0) + (hasBit(m, 8) ? 1 : 0) + (hasBit(m, 16) ? 1 : 0)

detTxt(int m, bool bull) =>
    string s = ""
    s := s + (hasBit(m, 1)  ? "✔ Déplacement\n" : "✘ Déplacement\n")
    s := s + (hasBit(m, 4)  ? "✔ BOS\n"         : "✘ BOS\n")
    s := s + (hasBit(m, 8)  ? "✔ Sweep liquidité\n" : "✘ Sweep liquidité\n")
    s := s + (hasBit(m, 2)  ? "✔ " : "✘ ") + (bull ? "Discount\n" : "Premium\n")
    s := s + (hasBit(m, 16) ? "✔ Tendance" : "✘ Tendance")
    s

// Exécutée sur chaque unité de temps via request.security()
// Bougie [2] = OB, bougie [1] = impulsion
obDetect() =>
    float atr         = ta.atr(atrLen)
    float ema         = ta.ema(close, emaLen)
    float ph          = ta.pivothigh(high, swingLen, swingLen)
    float pl          = ta.pivotlow(low, swingLen, swingLen)
    float lowestPrev  = ta.lowest(low, sweepLen)
    float highestPrev = ta.highest(high, sweepLen)

    var float swingHigh = na
    var float swingLow  = na
    if not na(ph)
        swingHigh := ph
    if not na(pl)
        swingLow := pl

    float sh2  = swingHigh[2]
    float sl2  = swingLow[2]
    float lp3  = lowestPrev[3]
    float hp3  = highestPrev[3]
    float atr1 = atr[1]
    float zTop = zoneMode == "Mèche" ? high[2] : math.max(open[2], close[2])
    float zBot = zoneMode == "Mèche" ? low[2]  : math.min(open[2], close[2])
    float zMid = (zTop + zBot) / 2

    // OB haussier : dernière bougie baissière avant une impulsion haussière
    bool bullBase = close[2] < open[2] and close[1] > open[1] and close[1] > high[2]
    int  bMask    = 0
    bMask += (close[1] - open[1]) >= dispMult * atr1 ? 1 : 0
    bMask += (not na(sh2)) and (not na(sl2)) and zMid < (sh2 + sl2) / 2 ? 2 : 0
    bMask += (not na(sh2)) and math.max(close[1], close) > sh2 ? 4 : 0
    bMask += (not na(lp3)) and low[2] < lp3 ? 8 : 0
    bMask += close > ema ? 16 : 0

    // OB baissier : dernière bougie haussière avant une impulsion baissière
    bool bearBase = close[2] > open[2] and close[1] < open[1] and close[1] < low[2]
    int  sMask    = 0
    sMask += (open[1] - close[1]) >= dispMult * atr1 ? 1 : 0
    sMask += (not na(sh2)) and (not na(sl2)) and zMid > (sh2 + sl2) / 2 ? 2 : 0
    sMask += (not na(sl2)) and math.min(close[1], close) < sl2 ? 4 : 0
    sMask += (not na(hp3)) and high[2] > hp3 ? 8 : 0
    sMask += close < ema ? 16 : 0

    int   t2   = time[2]

    var float bTop = na
    var float bBot = na
    var int   bTm  = 0
    var int   bMk  = 0
    var float sTop = na
    var float sBot = na
    var int   sTm  = 0
    var int   sMk  = 0

    if bullBase
        bTop := zTop
        bBot := zBot
        bTm  := t2
        bMk  := bMask
    if bearBase
        sTop := zTop
        sBot := zBot
        sTm  := t2
        sMk  := sMask

    // [1] = valeurs de la dernière bougie clôturée (non repaint)
    [bTop[1], bBot[1], bTm[1], bMk[1], sTop[1], sBot[1], sTm[1], sMk[1]]

// ───────────── Stockage des OB ─────────────
type OB
    box    bx
    label  lb
    float  top
    float  bot
    bool   bull
    int    stars
    string tf
    bool   touched

var array<OB> obs    = array.new<OB>()
var array<OB> broken = array.new<OB>()

addOB(float top, float bot, int t, int mask, bool bull, string tfName) =>
    int    stars = countStars(mask)
    color  c     = stars == 5 ? col5 : bull ? colBull : colBear
    string det   = detTxt(mask, bull)
    string txt   = (bull ? "▲ " : "▼ ") + tfName + " " + starStr(stars) + (showDet ? "\n" + det : "")
    box bx = box.new(t, top, time, bot, xloc = xloc.bar_time, border_color = c, border_width = stars == 5 ? borderW + 1 : borderW, bgcolor = color.new(c, fillTransp))
    label lb = na
    if showLbl
        lb := label.new(time, (top + bot) / 2, txt, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(c, lblTransp), textcolor = stars == 5 ? txtCol5 : txtCol, size = txtSize, tooltip = (bull ? "OB HAUSSIER " : "OB BAISSIER ") + tfName + " " + starStr(stars) + "\n" + det, textalign = text.align_left)
    obs.push(OB.new(bx, lb, top, bot, bull, stars, tfName, false))
    // garder seulement les maxPerTF OB les plus récents pour cette UT et ce sens
    int cnt = 0
    for i = obs.size() - 1 to 0
        OB o = obs.get(i)
        if o.tf == tfName and o.bull == bull
            cnt += 1
            if cnt > maxPerTF
                o.bx.delete()
                if not na(o.lb)
                    o.lb.delete()
                obs.remove(i)
    stars

// Non repaint : [1] + lookahead_on = dernière bougie CLÔTURÉE de l'UT demandée
handleTF(simple string tf, string tfName, bool enabled) =>
    [bT, bB, bTm, bM, sT, sB, sTm, sM] = request.security(syminfo.tickerid, tf, obDetect(), lookahead = barmerge.lookahead_on)
    bool usable  = enabled and timeframe.in_seconds(tf) >= timeframe.in_seconds()
    int  prevB   = nz(bTm[1])
    int  prevS   = nz(sTm[1])
    bool newBull = usable and bTm > 0 and bTm != prevB and not na(bT) and countStars(bM) >= minStars
    bool newBear = usable and sTm > 0 and sTm != prevS and not na(sT) and countStars(sM) >= minStars
    if newBull
        addOB(bT, bB, bTm, bM, true, tfName)
    if newBear
        addOB(sT, sB, sTm, sM, false, tfName)
    usable

// ───────────── Principal ─────────────
bool ok3  = handleTF("3",   "3m",  use3)
bool ok5  = handleTF("5",   "5m",  use5)
bool ok15 = handleTF("15",  "15m", use15)
bool ok4h = handleTF("240", "4H",  use4h)
bool okD  = handleTF("D",   "D",   useD)
bool okW  = handleTF("W",   "W",   useW)

int  futureT    = time + 10 * (time - nz(time[1], time))
bool touch5Bull = false
bool touch5Bear = false
bool touchMin   = false

if obs.size() > 0
    for i = obs.size() - 1 to 0
        OB o = obs.get(i)
        bool isBroken = o.bull ? (invMode == "Clôture" ? close < o.bot : low < o.bot) : (invMode == "Clôture" ? close > o.top : high > o.top)
        if isBroken
            obs.remove(i)
            if showBroken
                // l'OB reste affiché en gris, arrêté à la bougie qui l'a cassé
                o.bx.set_right(time)
                o.bx.set_bgcolor(color.new(colBroken, fillTransp))
                o.bx.set_border_color(colBroken)
                o.bx.set_border_style(line.style_dotted)
                if not na(o.lb)
                    o.lb.set_x(time)
                    o.lb.set_color(color.new(colBroken, lblTransp))
                    o.lb.set_textcolor(color.white)
                    o.lb.set_text("✖ " + o.tf + " " + starStr(o.stars) + " cassé")
                broken.push(o)
                if broken.size() > maxBroken
                    OB old = broken.shift()
                    old.bx.delete()
                    if not na(old.lb)
                        old.lb.delete()
            else
                o.bx.delete()
                if not na(o.lb)
                    o.lb.delete()
        else
            bool inZone = o.bull ? low <= o.top : high >= o.bot
            if inZone and not o.touched
                o.touched := true
                o.bx.set_border_style(line.style_dashed)
                if o.stars >= alertMinStars
                    touchMin := true
                    alert(syminfo.ticker + " : prix sur un OB " + (o.bull ? "HAUSSIER " : "BAISSIER ") + starStr(o.stars) + " [" + o.tf + "] " + str.tostring(o.bot, format.mintick) + " - " + str.tostring(o.top, format.mintick), alert.freq_once_per_bar)
                if o.stars == 5
                    if o.bull
                        touch5Bull := true
                    else
                        touch5Bear := true
            if barstate.islast
                o.bx.set_right(futureT)
                if not na(o.lb)
                    o.lb.set_x(futureT)

alertcondition(touch5Bull, "OB haussier 5★ touché", "{{ticker}} : le prix touche un OB HAUSSIER 5★")
alertcondition(touch5Bear, "OB baissier 5★ touché", "{{ticker}} : le prix touche un OB BAISSIER 5★")
alertcondition(touchMin,   "OB touché (étoiles min)", "{{ticker}} : le prix touche un OB bien noté")

// ───────────── Tableau ─────────────
bestStars(string tfName, bool bull) =>
    int best = -1
    if obs.size() > 0
        for i = 0 to obs.size() - 1
            OB o = obs.get(i)
            if o.tf == tfName and o.bull == bull and not o.touched and o.stars > best
                best := o.stars
    best

var table tbl = table.new(position.top_right, 3, 7, bgcolor = color.new(color.black, 20), border_color = color.new(color.gray, 60), border_width = 1)

fillRow(int row, string tfName, bool usable) =>
    table.cell(tbl, 0, row, tfName, text_color = color.white, text_size = size.small)
    int bu = usable ? bestStars(tfName, true)  : -1
    int be = usable ? bestStars(tfName, false) : -1
    string tu = not usable ? "off" : bu < 0 ? "—" : starStr(bu)
    string te = not usable ? "off" : be < 0 ? "—" : starStr(be)
    table.cell(tbl, 1, row, tu, text_color = not usable ? color.gray : bu == 5 ? col5 : colBull, text_size = size.small)
    table.cell(tbl, 2, row, te, text_color = not usable ? color.gray : be == 5 ? col5 : colBear, text_size = size.small)

if showTable and barstate.islast
    table.cell(tbl, 0, 0, "UT",            text_color = color.white, text_size = size.small)
    table.cell(tbl, 1, 0, "OB haussier",   text_color = colBull,     text_size = size.small)
    table.cell(tbl, 2, 0, "OB baissier",   text_color = colBear,     text_size = size.small)
    fillRow(1, "3m",  ok3)
    fillRow(2, "5m",  ok5)
    fillRow(3, "15m", ok15)
    fillRow(4, "4H",  ok4h)
    fillRow(5, "D",   okD)
    fillRow(6, "W",   okW)
